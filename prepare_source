# vim: ft=bash

# release tag from https://github.com/cyberus-technology/cloud-hypervisor/tags
EDK2_RELEASE_TAG="gardenlinux-release-26-09-16"
version_increment="0"

DATE_OF_TAG="${EDK2_RELEASE_TAG//[^0-9]/}"

git_src_commit "$EDK2_RELEASE_TAG" https://github.com/cyberus-technology/edk2.git

# debian specific things
cp -r debian "$dir/src/"

apply_patches

version="20260221"
version_suffix="+${DATE_OF_TAG}-1gl${version_increment}~bp2150"
message="Update to $version $version_suffix"
